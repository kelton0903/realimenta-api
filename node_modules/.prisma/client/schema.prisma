datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  bio       String?
  website   String?
  createdAt DateTime @default(now())

  projects Project[]

  @@map("profiles")
}

model Technology {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  projects Project[]

  @@map("technologies")
}

model Project {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  upvotes       Int      @default(0) // Curtidas / estrelas
  averageRating Float    @default(0.0) // Nota média calculada (1 a 5)
  createdAt     DateTime @default(now())

  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  technologies Technology[]
  feedbacks    Feedback[]

  @@map("projects")
}

model Feedback {
  id         Int      @id @default(autoincrement())
  authorName String
  comment    String
  rating     Int // Nota de 1 a 5
  createdAt  DateTime @default(now())

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}
