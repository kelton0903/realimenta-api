datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// Perfil da Instituição (Doador ou ONG)
model Profile {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  bio       String?
  website   String?
  createdAt DateTime  @default(now())

  // Relacionamento 1 : N com Project
  projects  Project[]

  @@map("profiles")
}

// Categorias e Conservação de Alimentos
model Technology {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?

  // Relacionamento N : N com Project
  projects    Project[]

  @@map("technologies")
}

// Projeto / Lote de Doação de Alimentos
model Project {
  id          Int          @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime     @default(now())

  // Chave estrangeira para Profile
  profileId   Int
  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Relacionamentos N : N e 1 : N
  technologies Technology[]
  feedbacks    Feedback[]

  @@map("projects")
}

// Opinião / Avaliação da Doação
model Feedback {
  id          Int      @id @default(autoincrement())
  authorName  String
  comment     String
  rating      Int
  createdAt   DateTime @default(now())

  projectId   Int
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}
